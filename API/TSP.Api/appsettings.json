{
  "ConnectionStrings": {
    "DefaultConntection": "Host=localhost;Port=5432;Database=db;Username=postgres;Password=password"
  },
  "Jwt": {
    "SigningKey": "Key",
    "Issuer": "MyApp",
    "Audience": "MyApp.Api",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "CorsPaths": [
    "http://localhost:5173"
  ],
  "AllowedHosts": "*"
}